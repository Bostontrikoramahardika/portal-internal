<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BTM Portal — Offline</title>
  <link rel="icon" href="/btm-fix.png">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
      background: #f4f7fa;
      background-image: radial-gradient(circle at 20% 30%, rgba(0,61,121,0.06) 0%, transparent 40%),
                        radial-gradient(circle at 80% 70%, rgba(0,61,121,0.08) 0%, transparent 40%);
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 24px;
      color: #1e293b;
    }
    
    .container {
      max-width: 380px;
      width: 100%;
    }
    
    .card {
      background: white;
      border-radius: 2rem;
      padding: 2.5rem 2rem;
      text-align: center;
      box-shadow: 0 20px 50px rgba(0,61,121,0.12);
    }
    
    .icon-wrapper {
      width: 96px;
      height: 96px;
      background: linear-gradient(135deg, #003D79, #0056b3);
      border-radius: 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
      box-shadow: 0 10px 30px rgba(0,61,121,0.25);
    }
    
    .icon-wrapper svg {
      width: 48px;
      height: 48px;
      color: white;
    }
    
    h1 {
      color: #003D79;
      font-size: 1.5rem;
      font-weight: 900;
      margin-bottom: 0.5rem;
      letter-spacing: -0.02em;
    }
    
    .subtitle {
      color: #64748b;
      font-size: 0.875rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }
    
    .info-box {
      background: #f0f7ff;
      border: 1px solid #cfe3ff;
      border-radius: 1rem;
      padding: 1rem;
      margin-bottom: 1.5rem;
      text-align: left;
    }
    
    .info-title {
      color: #003D79;
      font-size: 0.75rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 0.5rem;
    }
    
    .info-text {
      color: #475569;
      font-size: 0.813rem;
      line-height: 1.5;
    }
    
    .button {
      background: #003D79;
      color: white;
      border: none;
      border-radius: 1.5rem;
      padding: 1rem 2rem;
      font-size: 0.875rem;
      font-weight: 900;
      cursor: pointer;
      width: 100%;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }
    
    .button:hover {
      background: #002855;
      transform: translateY(-1px);
    }
    
    .button:active {
      transform: translateY(0);
    }
    
    .button-secondary {
      background: transparent;
      color: #003D79;
      margin-top: 0.75rem;
      border: 2px solid #003D79;
    }
    
    .button-secondary:hover {
      background: #f0f7ff;
    }
    
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: #fef3c7;
      color: #92400e;
      padding: 0.5rem 1rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 1rem;
    }
    
    .status-badge.online {
      background: #dcfce7;
      color: #166534;
    }
    
    .pulse {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: currentColor;
      animation: pulse 2s ease-in-out infinite;
    }
    
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    
    .footer-text {
      text-align: center;
      color: #94a3b8;
      font-size: 0.75rem;
      margin-top: 1.5rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <div class="icon-wrapper">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636a9 9 0 010 12.728m-3.536-3.536a4 4 0 010-5.656M12 12h.01M9.172 8.464a4 4 0 015.656 0M5.636 5.636a9 9 0 000 12.728" />
        </svg>
      </div>
      
      <div class="status-badge" id="status-badge">
        <span class="pulse"></span>
        <span id="status-text">Tidak Ada Koneksi</span>
      </div>
      
      <h1>Anda Sedang Offline</h1>
      <p class="subtitle">
        BTM Portal terputus dari internet.<br>
        Fitur absensi tetap bisa digunakan.
      </p>
      
      <div class="info-box">
        <div class="info-title">💡 Info</div>
        <div class="info-text">
          Data absensi Anda akan tersimpan di HP dan otomatis terkirim ke server saat koneksi kembali.
        </div>
      </div>
      
      <button class="button" onclick="tryReconnect()">
        🔄 <span>Coba Sambungkan Ulang</span>
      </button>
      
      <button class="button button-secondary" onclick="goToDashboard()">
        📱 <span>Buka Dashboard</span>
      </button>
      
      <p class="footer-text">
        BTM Portal · PT. Boston Trikorama Hardika
      </p>
    </div>
  </div>

  <script>
    // Deteksi status online/offline
    function updateStatus() {
      const badge = document.getElementById('status-badge');
      const text = document.getElementById('status-text');
      
      if (navigator.onLine) {
        badge.classList.add('online');
        text.textContent = 'Koneksi Kembali!';
        // Auto redirect setelah 1 detik
        setTimeout(() => window.location.href = '/dashboard', 1000);
      } else {
        badge.classList.remove('online');
        text.textContent = 'Tidak Ada Koneksi';
      }
    }
    
    // Coba reconnect manual
    function tryReconnect() {
      const btn = event.target.closest('button');
      const originalText = btn.innerHTML;
      btn.innerHTML = '⏳ <span>Mencoba...</span>';
      btn.disabled = true;
      
      fetch('/api/health-check', { method: 'HEAD', cache: 'no-cache' })
        .then(() => {
          window.location.href = '/dashboard';
        })
        .catch(() => {
          btn.innerHTML = originalText;
          btn.disabled = false;
          alert('Masih belum ada koneksi. Coba beberapa saat lagi.');
        });
    }
    
    // Ke dashboard (mode offline)
    function goToDashboard() {
      window.location.href = '/dashboard';
    }
    
    // Listen event online/offline
    window.addEventListener('online', updateStatus);
    window.addEventListener('offline', updateStatus);
    
    // Cek status saat load
    updateStatus();
  </script>
</body>
</html>